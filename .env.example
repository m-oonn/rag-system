# ================================================================
# RAG Knowledge Base Q&A System - Configuration
# ================================================================
# Copy this file to .env and fill in your values.
# ================================================================

# App
APP_NAME=RAG-Knowledge-Base
APP_ENV=development
DEBUG=true

# Security (CHANGE this in production!)
SECRET_KEY=change-me-to-a-random-string

# ================================================================
# Vector Store ("chroma" or "milvus")
# ================================================================
VECTOR_STORE=chroma

# ================================================================
# LLM Provider ("ollama", "deepseek", or "dashscope")
# ================================================================
LLM_PROVIDER=ollama

# Ollama (local, free, no API key)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# DeepSeek (cheap cloud, ~1 yuan per 1000 calls)
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_MODEL=deepseek-chat

# DashScope / Qwen (Alibaba cloud)
# DASHSCOPE_API_KEY=sk-your-key-here
# LLM_MODEL=qwen-max

# ================================================================
# Embedding Provider ("sentence-transformers" or "dashscope")
# ================================================================
EMBEDDING_PROVIDER=sentence-transformers
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# ================================================================
# Rerank ("none", "local", or "dashscope")
# ================================================================
RERANK_PROVIDER=local
RERANK_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANK=true
RERANK_TOP_N=5

# ================================================================
# RAG Parameters
# ================================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=20
ENABLE_MULTI_HOP=false

# ================================================================
# Database
# ================================================================
DATABASE_URL=sqlite:///./rag_system.db

# ================================================================
# Optional: Enterprise Infrastructure
# ================================================================
# ENABLE_CELERY=false
# ENABLE_MINIO=false

# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# REDIS_URL=redis://localhost:6379/0
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
